#!/bin/bash
#
# Pre-commit hook for honeyclip
# Validates code quality, runs tests, and checks for common issues
#
# Installation:
#   ./scripts/install-hooks.sh
#
# Skip hook (when needed):
#   git commit --no-verify

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Check if running in CI (skip some checks)
if [ -n "$CI" ]; then
  echo "Running in CI, skipping pre-commit hook"
  exit 0
fi

# Track overall status
FAILED=0

# Helper functions
print_header() {
  echo -e "\n${BLUE}==>${NC} $1"
}

print_success() {
  echo -e "${GREEN}✓${NC} $1"
}

print_warning() {
  echo -e "${YELLOW}⚠${NC} $1"
}

print_error() {
  echo -e "${RED}✗${NC} $1"
  FAILED=1
}

# Get list of staged .nim files
STAGED_NIM_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.nim$' || true)

# Get list of all staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM || true)

# If no files staged, exit early
if [ -z "$STAGED_FILES" ]; then
  echo "No files staged for commit"
  exit 0
fi

print_header "Running pre-commit checks..."

# =============================================================================
# Check 1: File size validation (prevent accidentally committing large files)
# =============================================================================
print_header "Checking file sizes..."

MAX_FILE_SIZE=$((5 * 1024 * 1024))  # 5MB limit
LARGE_FILES=""

for file in $STAGED_FILES; do
  if [ -f "$file" ]; then
    size=$(stat -f%z "$file" 2>/dev/null || stat -c%s "$file" 2>/dev/null || echo 0)
    if [ "$size" -gt "$MAX_FILE_SIZE" ]; then
      # Exceptions: allow large files in specific directories
      case "$file" in
        resources/*|tests/resources/*|ml_sources/*|ffmpeg_sources/*)
          print_warning "Large file allowed: $file ($(numfmt --to=iec-i --suffix=B $size 2>/dev/null || echo ${size}B))"
          ;;
        *)
          LARGE_FILES="$LARGE_FILES\n  $file ($(numfmt --to=iec-i --suffix=B $size 2>/dev/null || echo ${size}B))"
          ;;
      esac
    fi
  fi
done

if [ -n "$LARGE_FILES" ]; then
  print_error "Large files detected (>5MB):$LARGE_FILES"
  echo "  If this is intentional, add to .gitignore or use --no-verify"
else
  print_success "No large files detected"
fi

# =============================================================================
# Check 2: Secrets detection (prevent committing API keys, passwords, etc.)
# =============================================================================
print_header "Checking for secrets..."

SECRET_PATTERNS=(
  'password\s*=\s*['\''"].*['\''"]'
  'api_key\s*=\s*['\''"].*['\''"]'
  'secret\s*=\s*['\''"].*['\''"]'
  'token\s*=\s*['\''"].*['\''"]'
  'bearer\s+[a-zA-Z0-9_\-]+'
  '-----BEGIN.*PRIVATE KEY-----'
)

SECRETS_FOUND=""

for pattern in "${SECRET_PATTERNS[@]}"; do
  for file in $STAGED_FILES; do
    # Skip binary files and known safe files
    case "$file" in
      *.bin|*.exe|*.o|*.a|*.so|*.dylib|*.dll|*.png|*.jpg|*.mp4)
        continue
        ;;
    esac
    
    if [ -f "$file" ]; then
      matches=$(grep -iE "$pattern" "$file" || true)
      if [ -n "$matches" ]; then
        # Check if it's a false positive (e.g., in comments, test fixtures)
        if ! echo "$matches" | grep -qE '(#|//|TODO|FIXME|example|test|fixture)'; then
          SECRETS_FOUND="$SECRETS_FOUND\n  $file: $pattern"
        fi
      fi
    fi
  done
done

if [ -n "$SECRETS_FOUND" ]; then
  print_error "Possible secrets detected:$SECRETS_FOUND"
  echo "  Review these files and remove secrets before committing"
  echo "  Use environment variables or config files (not tracked in git)"
else
  print_success "No secrets detected"
fi

# =============================================================================
# Check 3: Debug code detection (prevent committing debug prints)
# =============================================================================
print_header "Checking for debug code..."

DEBUG_PATTERNS=(
  "echo.*DEBUG"
  "debugEcho"
  "echo.*FIXME"
  "echo.*XXX"
  "console\.log.*DEBUG"
)

DEBUG_FOUND=""

for file in $STAGED_NIM_FILES; do
  for pattern in "${DEBUG_PATTERNS[@]}"; do
    matches=$(grep -n "$pattern" "$file" 2>/dev/null || true)
    if [ -n "$matches" ]; then
      DEBUG_FOUND="$DEBUG_FOUND\n  $file: $matches"
    fi
  done
done

if [ -n "$DEBUG_FOUND" ]; then
  print_warning "Debug code detected (review before committing):$DEBUG_FOUND"
  # Warning only, don't fail (debug code is sometimes intentional)
else
  print_success "No debug code detected"
fi

# =============================================================================
# Check 4: TODO markers (ensure TODOs reference issue numbers)
# =============================================================================
print_header "Checking TODO markers..."

TODO_WITHOUT_ISSUE=""

for file in $STAGED_FILES; do
  # Skip binary and generated files
  case "$file" in
    *.bin|*.exe|*.o|*.a|*.so|*.dylib|*.dll|*.png|*.jpg|*.mp4|nimcache/*|build/*)
      continue
      ;;
  esac
  
  if [ -f "$file" ]; then
    # Look for TODO without issue number (e.g., TODO(#123) is OK, TODO alone is not)
    todos=$(grep -n "TODO" "$file" 2>/dev/null | grep -v "TODO(#[0-9]" | grep -v "TODO:" || true)
    if [ -n "$todos" ]; then
      TODO_WITHOUT_ISSUE="$TODO_WITHOUT_ISSUE\n  $file:\n$(echo "$todos" | sed 's/^/    /')"
    fi
  fi
done

if [ -n "$TODO_WITHOUT_ISSUE" ]; then
  print_warning "TODOs without issue numbers:$TODO_WITHOUT_ISSUE"
  echo "  Consider adding issue references: TODO(#123) or TODO: description"
  # Warning only, don't fail
else
  print_success "All TODOs properly documented"
fi

# =============================================================================
# Check 5: Nim syntax check (only on changed .nim files)
# =============================================================================
if [ -n "$STAGED_NIM_FILES" ]; then
  print_header "Checking Nim syntax..."
  
  NIM_CHECK_FAILED=""
  
  for file in $STAGED_NIM_FILES; do
    # Run nim check (fast, no compilation)
    if ! nim check --hints:off "$file" 2>&1 | grep -v "^Hint:" > /tmp/nim_check_output.txt; then
      NIM_CHECK_FAILED="$NIM_CHECK_FAILED\n  $file:\n$(cat /tmp/nim_check_output.txt | sed 's/^/    /')"
    fi
  done
  
  if [ -n "$NIM_CHECK_FAILED" ]; then
    print_error "Nim syntax errors:$NIM_CHECK_FAILED"
  else
    print_success "Nim syntax check passed"
  fi
  
  rm -f /tmp/nim_check_output.txt
fi

# =============================================================================
# Check 6: Unit tests (fast, always run)
# =============================================================================
print_header "Running unit tests..."

# Only run tests if source files changed (not just docs)
SOURCE_CHANGED=$(echo "$STAGED_FILES" | grep -E '\.(nim|c|h)$' || true)

if [ -n "$SOURCE_CHANGED" ]; then
  # Run tests with timeout (prevent hanging)
  if timeout 60s nimble test > /tmp/test_output.txt 2>&1; then
    print_success "Unit tests passed"
  else
    print_error "Unit tests failed:"
    cat /tmp/test_output.txt | tail -20 | sed 's/^/  /'
    echo "  See full output in /tmp/test_output.txt"
  fi
  rm -f /tmp/test_output.txt
else
  print_success "Unit tests skipped (no source changes)"
fi

# =============================================================================
# Check 7: Cross-platform compatibility (optional, slow)
# =============================================================================
# This check is disabled by default (too slow for pre-commit)
# Enable by setting: export PRECOMMIT_CHECK_WINDOWS=1

if [ -n "$PRECOMMIT_CHECK_WINDOWS" ] && [ "$PRECOMMIT_CHECK_WINDOWS" = "1" ]; then
  print_header "Checking Windows cross-compilation..."
  
  if [ -n "$SOURCE_CHANGED" ]; then
    # Only check if not on Windows (cross-compile check)
    if [[ "$OSTYPE" != "msys" ]] && [[ "$OSTYPE" != "win32" ]]; then
      if timeout 120s nimble windows > /tmp/windows_check.txt 2>&1; then
        print_success "Windows cross-compilation successful"
      else
        print_error "Windows cross-compilation failed:"
        cat /tmp/windows_check.txt | tail -20 | sed 's/^/  /'
      fi
      rm -f /tmp/windows_check.txt
    else
      print_success "Windows cross-compilation skipped (running on Windows)"
    fi
  else
    print_success "Windows cross-compilation skipped (no source changes)"
  fi
else
  print_warning "Windows cross-compilation check disabled (enable: export PRECOMMIT_CHECK_WINDOWS=1)"
fi

# =============================================================================
# Check 8: Formatting check (optional)
# =============================================================================
# Nim doesn't have a standard formatter, so this is optional
# If nimpretty is used, check formatting here

# =============================================================================
# Check 9: Platform-specific code validation
# =============================================================================
print_header "Checking platform-specific code..."

MISSING_PLATFORM_GUARDS=""

for file in $STAGED_NIM_FILES; do
  # Check for Windows-specific code without guards
  if grep -qE '(mingw|win32|windows\.h|GetProcessMemoryInfo)' "$file" 2>/dev/null; then
    if ! grep -qE 'when\s+(defined\(windows\)|not defined\(windows\))' "$file" 2>/dev/null; then
      MISSING_PLATFORM_GUARDS="$MISSING_PLATFORM_GUARDS\n  $file: Windows-specific code without 'when defined(windows)' guard"
    fi
  fi
  
  # Check for Linux-specific code without guards
  if grep -qE '(linux\.h|/proc/|posix)' "$file" 2>/dev/null; then
    if ! grep -qE 'when\s+(defined\(linux\)|not defined\(windows\))' "$file" 2>/dev/null; then
      MISSING_PLATFORM_GUARDS="$MISSING_PLATFORM_GUARDS\n  $file: Linux-specific code without 'when defined(linux)' guard"
    fi
  fi
  
  # Check for macOS-specific code without guards
  if grep -qE '(darwin\.h|mach_task|__APPLE__)' "$file" 2>/dev/null; then
    if ! grep -qE 'when\s+defined\(macosx\)' "$file" 2>/dev/null; then
      MISSING_PLATFORM_GUARDS="$MISSING_PLATFORM_GUARDS\n  $file: macOS-specific code without 'when defined(macosx)' guard"
    fi
  fi
done

if [ -n "$MISSING_PLATFORM_GUARDS" ]; then
  print_warning "Platform-specific code without guards:$MISSING_PLATFORM_GUARDS"
  echo "  Add 'when defined(windows)' or similar guards for cross-platform compatibility"
  # Warning only, might be false positives
else
  print_success "Platform-specific code properly guarded"
fi

# =============================================================================
# Final summary
# =============================================================================
echo ""
if [ $FAILED -eq 0 ]; then
  echo -e "${GREEN}✓ All pre-commit checks passed!${NC}"
  exit 0
else
  echo -e "${RED}✗ Pre-commit checks failed!${NC}"
  echo ""
  echo "Fix the errors above or use 'git commit --no-verify' to skip checks"
  exit 1
fi
